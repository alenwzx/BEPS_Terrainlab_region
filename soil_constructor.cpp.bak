/**************************************************************************************************************
    1. soilindex[k] (k ∈ 0 ~ 11) ,该结构体数组规定了12种土壤的基本属性. 声明：BepsHydrScience.h line258; 赋值：readconf.cpp line127
    2. soil[j] (j ∈ 0 ~ pv->npixels) ，该结构体数组描述了一行像元的土壤属性. 声明：BepsHydrScience.h line207 赋值：soil_constructor.cpp
**************************************************************************************************************/
#include <algorithm>
#include <cmath>
#include <cstdio>
#include "stdafx.h"
#include "BepsHydrScience.h"
#include <cstdio>
#include <cmath>
#include <stdio.h>

void Soil_constructor(pubv* pv, unsigned char* soil_texture,
                      float* soil_surf_kv,float* soil_surf_ks, float* soil_init_z, float* soil_init_temp,
                      float* carbon_pool1,float* carbon_pool2,float* carbon_pool3,float* carbon_pool4,float* carbon_pool5,float* carbon_pool6,float* carbon_pool7,float* carbon_pool8,float* carbon_pool9,
                      float* biomass_pool1,float* biomass_pool2,float* biomass_pool3,float* biomass_pool4,float* soil_depth,
                      Soil_index_t* soilindex, int iLine, Soil_t* soil, unsigned char* watershed,int line,float*buffer_nitrogen, float** initial_soil_moisture)
{
    short textureindex;
    float w,air_entry,z,depth = 0;

    for(int j=0; j<pv->npixels; j++)
    {
        // 设置 textureindex(∈0-11) 映射 soil_texture[j](∈10-120)
        if(soil_texture[j]>0 && soil_texture[j]<=120)
            textureindex=soil_texture[j]/10-1;
        else
            textureindex=1;
        // 边界赋值
        if (watershed[j] == 0 ||soil_init_z[j]  <-10.0)
        {
            soil[j].K0_decay_m          = soilindex[4].pore_index;      // -99.0f;	//soil parameter for Kz calculation
            soil[j].soil_b              = soilindex[4].soil_b[0];       // -99.0f;
            soil[j].saturation_suction  = soilindex[4].suction_head[0];	// -99.0f;	//suction in meters when soil is saturation
            soil[j].saturated_Kv        = soilindex[4].soil_K0[0];      // -99.0f;	//at surface. m per day
            soil[j].saturated_Ks        = soilindex[4].soil_K0H[0];     // -99.0f;	//at surface. m per day
            soil[j].saturation_deficit  = 0;                          // -99.0f;	//meter. Zero at saturation
            soil[j].water_table         = 2.0;	                        //meter from soil surface
            soil[j].pondwater           = 0.0;	                        //pond 为什么池塘水体设为0呢?这个设置应该针对的是研究区外的边界点
            soil[j].unsaturated_storage = 0.0;// -99.0f;	//meter	....MEM: of water in the unsaturated zone!!!
            soil[j].Max_depth_Z         = 2.0;                          // -99.0f;	//meter	//ori 1.0 on 23jun

            soil[j].thetam[0]                   = 0;
            soil[j].thetam[1]                   = 0;
            soil[j].thetam[2]                   = 0;
            soil[j].thetam[3]                   = 0;
            soil[j].thetam[4]                   = 0;

            soil[j].thetam_prev[0]              = 0;
            soil[j].thetam_prev[1]              = 0;
            soil[j].thetam_prev[2]              = 0;
            soil[j].thetam_prev[3]              = 0;
            soil[j].thetam_prev[4]              = 0;
        }
        //研究区内赋值
        else
        {
            //find a corresponding texture name, then calculate values for other items ,根据 mytexture(∈10-120),soil_texture[j](∈10-120) 的一致性，遍历寻找对应的土壤类型并为赋予土壤属性值
            for(int k=0; k<12; k++)
            {
                if ((int)soil_texture[j] == soilindex[k].mytexture)	//***Added by Andriy
                {
                    soil[j].K0_decay_m			= (float)soilindex[k].pore_index;
                    soil[j].soil_b				= (float)soilindex[k].soil_b[0];
                    soil[j].saturation_suction	= (float)soilindex[k].suction_head[0];
                    soil[j].saturated_Kv		= (float)soilindex[k].soil_K0[0];
                    soil[j].saturated_Ks		= (float)soilindex[k].soil_K0H[0];

                    // Check if the initial soil moisture data was passed in
                    bool has_initial_moisture = initial_soil_moisture != nullptr && initial_soil_moisture[0] != nullptr;
                    has_initial_moisture = false;
                    if (has_initial_moisture)
                    {
                        for (int layer = 0; layer < 5; layer++) {
                            soil[j].thetam[layer] = initial_soil_moisture[layer][j];
                            soil[j].thetam_prev[layer] = initial_soil_moisture[layer][j];
                        }
                    }
                    else
                    {   
                    float dx = 1.1;
                        soil[j].thetam[0] = (float)0.8 * soilindex[k].field_cap[0] * dx;
                        soil[j].thetam[1] = soilindex[k].field_cap[1] * dx;
                        soil[j].thetam[2] = (float)1.05 * soilindex[k].field_cap[2] * dx;
                        soil[j].thetam[3] = (float)1.10 * soilindex[k].field_cap[3] * dx;
                        soil[j].thetam[4] = (float)1.15 * soilindex[k].field_cap[4] * dx;

                        soil[j].thetam_prev[0] = soil[j].thetam[0];
                        soil[j].thetam_prev[1] = soil[j].thetam[1];
                        soil[j].thetam_prev[2] = soil[j].thetam[2];
                        soil[j].thetam_prev[3] = soil[j].thetam[3];
                        soil[j].thetam_prev[4] = soil[j].thetam[4];
                    }

                    soil[j].d_soil[0]           = 0.05;		/* depth_layer0 */
                    soil[j].d_soil[1]           = 0.10;		/* depth_layer1 */
                    soil[j].d_soil[2]           = 0.20;		/* depth_layer2 */
                    soil[j].d_soil[3]           = 1.65;		/* depth_layer3 */
                    soil[j].d_soil[4]           = 1;		/* depth_layer4 */

                    /*土壤深度*/
                    if (soil_depth[j]	<= -9999.0f) //soil-depth.bin 设置成-9999.0f即可
                    {
                        soil[j].Max_depth_Z		= (float)soilindex[k].max_z;
                    }
                    else
                        soil[j].Max_depth_Z		= (float)soil_depth[j];

                    /*初始地下水深度*/
                    if(soil_init_z[j] <= -9999.0f)   //if 9999, use the default
                        soil[j].water_table		= -999;//(float) (soil[j].Max_depth_Z/2.0);
                    else
                    {
                        soil[j].water_table		= (float)soil_init_z[j];
                        soil[j].soil_temp		= (float)soil_init_temp[j];
                        soil[j].pool1		= (float)carbon_pool1[j];
                        soil[j].pool2		= (float)carbon_pool2[j];
                        soil[j].pool3		= (float)carbon_pool3[j];
                        soil[j].pool4		= (float)carbon_pool4[j];
                        soil[j].pool5		= (float)carbon_pool5[j];
                        soil[j].pool6		= (float)carbon_pool6[j];
                        soil[j].pool7		= (float)carbon_pool7[j];
                        soil[j].pool8		= (float)carbon_pool8[j];
                        soil[j].pool9		= (float)carbon_pool9[j];
                        soil[j].poolb1	    = (float)biomass_pool1[j];
                        soil[j].poolb2	    = (float)biomass_pool2[j];
                        soil[j].poolb3	    = (float)biomass_pool3[j];
                        soil[j].poolb4	    = (float)biomass_pool4[j];
                        soil[j].nitrogen	= 0.013;//(float)buffer_nitrogen[j];
                        soil[j].CNcd_m=180.26;//these should be initialized using intec values
                        soil[j].CNssd_m=65.32;
                        soil[j].CNsmd_m=15.32;
                        soil[j].CNfsd_m=30.32;
                        soil[j].CNfmd_m=15.32;
                        soil[j].CNsm_m=12.00;
                        soil[j].CNm_m=12.00;
                        soil[j].CNs_m=38.74;
                        soil[j].CNp_m=30.32;
                        soil[j].CNw_m=100.32;
                        soil[j].CNfr_m=56.32;
                        soil[j].CNl_m=56.32;
                        soil[j].ST_Layer_1=5;//these should be using measured values
                        soil[j].ST_Layer_2=5;
                        soil[j].ST_Layer_3=5;
                        soil[j].ST_Layer_4=5;
                        soil[j].ST_Layer_5=5;
                        soil[j].ST_Layer_6=5;
                        soil[j].pondwater=0;
                    }

                }//end of if block
            }//end of k for loop

            // w=0.92f;	//wetnees value between 0.9 and 1.0. See Clapp and Hornberger, 1978
            // air_entry = soil[j].saturation_suction*(float)pow(w,(double)-soil[j].K0_decay_m);

            //不饱和区土壤深度Z
            z = MIN(soil[j].water_table, soil[j].Max_depth_Z);
            if (z > 0)//存在不饱和区
            {   //不饱和区土壤田间含水量
            //     soil[j].unsaturated_storage	= (float)soilindex[textureindex].field_cap*z;
            //     //土壤饱和差
            //     soil[j].saturation_deficit	= (float)(MIN(soilindex[textureindex].porosity,1))*z - soil[j].unsaturated_storage;

            for(int i=0;i<MAX_LAYERS-2;i++)
                {
                soil[j].unsaturated_storage += float(soil[j].thetam[i] * soil[j].d_soil[i]);
                depth += soil[j].d_soil[i];
                }
            	soil[j].unsaturated_storage /= depth;
                // 使用第一层的孔隙度作为代表值
                soil[j].saturation_deficit  = soilindex[textureindex].porosity[0] - soil[j].unsaturated_storage;
            }

            else//不存在不饱和区
            {
                soil[j].saturation_deficit = 0.0;
                soil[j].unsaturated_storage=0.0;
            }
        }//end of if-else block within the for loop

    }//end of j loop 结束行像元的遍历

}

void Init_Soil_Parameters(const pubv* pv, const unsigned  char* landcover, const Soil_index_t* soilindex,Soil_t* soil,const unsigned char* watershed, const unsigned char* soil_texture ,int line, int iDay , const Canopy_t* canopy_ptr, float* waterin, int CFL, Soil_t* Soil_Array_3r, float* Array_Ele)
{
    short textureindex;
    float Trans_o, Trans_u, Evap_soil, depth ;
    for (int j=0; j<pv->npixels; j++)
    {
        if (watershed[j] != 0)
        {
            // 设置 textureindex(∈0-11) 映射 soil_texture[j](∈10-120)
            if(soil_texture[j]>0 && soil_texture[j]<=120)
                textureindex=soil_texture[j]/10-1;            else
                textureindex=1;

            // 设置与土壤质地有关的变量
            for(int i=0; i<MAX_LAYERS; i++){
                soil[j].thermal_cond[i]	        = 8.0;// thermal conductivity. Unit:
                soil[j].theta_vfc[i]		    = (float)soilindex[textureindex].field_cap[i];     // field capacity - now layered
                soil[j].theta_vwp[i]		    = (float)soilindex[textureindex].wilting_pt;       // wilt point
                soil[j].fei[i]                  = (float)soilindex[textureindex].porosity[i];      // porosity - now layered
                soil[j].b[i]				    = (float)soilindex[textureindex].soil_b[i];        // soil b
                soil[j].pn[i]                   = (float)soilindex[textureindex].soil_b[i];         // VGM n
                soil[j].pm[i]                   = 1.0f - 1.0f / soil[j].pn[i];                     // VGM m
                soil[j].Ksat[i]                 = (float)soilindex[textureindex].soil_K0[i]/kstep; // saturated hydraulic conductivity
                soil[j].psi_sat[i]              = (float)soilindex[textureindex].suction_head[i];  // water potential at sat
                soil[j].ice_ratio[i]            = 0;
            }
            soil[j].soil_r                      = (float)(1/soilindex[textureindex].MaxiGs);       //soil resistance

            // 设置与土地覆盖有关的变量
            switch(landcover[j])
            {
                case 2:
                case 4:
                    soil[j].psi_min         = 10.0;
                    soil[j].alpha           = 1.5;
                break;
                default:
                    soil[j].psi_min         = 33.0;
                    soil[j].alpha           = 0.4;
                break;
            }

            soil[j].n_layer             = MAX_LAYERS;
            soil[j].flag                = 1;
            soil[j].Zp                  = soil[j].pondwater;            // depth of ponded water on the surface
            // soil[j].Zp                  = 0.0;
            soil[j].Zsp                 = 0.0;                          // depth of snow on the surface

            soil[j].f_soilwater         = 1;

            soil[j].d_soil[0]           = 0.05;		/* depth_layer0 */
            soil[j].d_soil[1]           = 0.10;		/* depth_layer1 */
            soil[j].d_soil[2]           = 0.70;		/* depth_layer2 */
            soil[j].d_soil[3]           = 1.35;		/* depth_layer3 */
            soil[j].d_soil[4]           = 1;		/* depth_layer4 */
            soil[j].r_root_decay        = 0.95;
            SoilRootFraction(&soil[j]);


            soil[j].density_soil[0] = 1300.0;   // from flux tower.
            soil[j].density_soil[1] = 1500.0;
            soil[j].density_soil[2] = 1517.0;
            soil[j].density_soil[3] = 1517.0;
            soil[j].density_soil[4] = 1517.0;

            soil[j].f_org[0]        = 5;
            soil[j].f_org[1]        = 2;
            soil[j].f_org[2]        = 1;
            soil[j].f_org[3]        = 1;
            soil[j].f_org[4]        = 0.3;

            soil[j].temp_soil_c[0] = MAX(soil[j].ST_Layer_1,5);
            soil[j].temp_soil_c[1] = MAX(soil[j].ST_Layer_2,5);
            soil[j].temp_soil_c[2] = MAX(soil[j].ST_Layer_3,5);
            soil[j].temp_soil_c[3] = MAX(soil[j].ST_Layer_4,5);
            soil[j].temp_soil_c[4] = MAX(soil[j].ST_Layer_5,5);

            soil[j].temp_soil_p[0] = MAX(soil[j].ST_Layer_1,5);
            soil[j].temp_soil_p[1] = MAX(soil[j].ST_Layer_2,5);
            soil[j].temp_soil_p[2] = MAX(soil[j].ST_Layer_3,5);
            soil[j].temp_soil_p[3] = MAX(soil[j].ST_Layer_4,5);
            soil[j].temp_soil_p[4] = MAX(soil[j].ST_Layer_5,5);

            Trans_o     = (float)canopy_ptr[j].canopy_transpiration_unsat/kstep/1000.0;
            Trans_u     = 0;
            Evap_soil   = (float)(canopy_ptr[j].moss_transpiration + canopy_ptr[j].soil_evaporation)/kstep/1000.0;
            soil[j].r_rain_g = waterin[j]/float(kstep);  // the rainfall rate, un--on understory g--on ground surface  m/s

            soil_water_factor_v2(&soil[j]);
            Soil_Water_Uptake(&soil[j],Trans_o,Trans_u,Evap_soil);

            for(int i=0;i<kstep/steps/CFL;i++)
            {
                soil[j].dz = soil[j].water_table;
                soil[j].Zp = soil[j].pondwater;
                UpdateSoilMoisture(&soil[j], float(steps));
                // 新增：侧向流动自适应步长与水分更新
                // UpdateSoilLateralFlow((pubv*)pv, line, j, soil, Soil_Array_3r, Array_Ele, (unsigned char*)watershed, (unsigned char*)soil_texture, (Soil_index_t*)soilindex, float(steps));
                soil[j].pondwater = soil[j].Zp;
                soil[j].water_table = (float)soil[j].dz;
            }

            depth = 0;
            soil[j].unsaturated_storage = 0;

            for(int i=0;i<MAX_LAYERS-2;i++)
            {
                soil[j].unsaturated_storage += soil[j].thetam[i] * soil[j].d_soil[i];
                depth += soil[j].d_soil[i];
            }
            soil[j].unsaturated_storage /= depth;

            // soil[j].unsaturated_storage = soil[j].thetam[4];

            // if(iDay==4)
            //     printf("%.10f\n",soil[j].Zp);
        }
    }
}

void SoilRootFraction(Soil_t* soil)
{
    int i;
    float cum_depth[MAX_LAYERS];

    // for the 0 layer
    cum_depth[0] = soil->d_soil[0];
    soil->f_root[0] = 1 - std::pow(soil->r_root_decay, cum_depth[0] * 100);

    // for 1 to n_layer-1
    for (i = 1; i < soil->n_layer - 1; i++)
    {
        cum_depth[i] = cum_depth[i - 1] + soil->d_soil[i];
        soil->f_root[i] = std::pow(soil->r_root_decay, cum_depth[i - 1] * 100) - std::pow(soil->r_root_decay, cum_depth[i] * 100);
    }

    // for the last layer. Put all reminding roots to the last layer.
    // soil->Layer[layer].f_root = 1 - (1-pow(soil->r_root_decay, cum_depth[i-1] *100));
    soil->f_root[soil->n_layer - 1] = std::pow(soil->r_root_decay, cum_depth[soil->n_layer - 2] * 100);
}

void soil_water_factor_v2(Soil_t* soil)
{
    float	ft[MAX_LAYERS], fpsisr[MAX_LAYERS];
    float	dtt[MAX_LAYERS];
    float t1, t2;
//	double fw;
    int i;

    t1 = -0.02;
    t2 = 2.0;

    if (soil->psim[0] <= 0.000001) // just in case that this function is called before "updatesoilmoisture". LHE
        for (i = 0; i < soil->n_layer; i++)
        {
            soil->psim[i] = soil->psi_sat[i] * std::pow(soil->thetam[i] / soil->fei[i], -soil->b[i]);
            soil->psim[i] = MAX(soil->psi_sat[i], soil->psim[i]);  // I see no necessity to use this line unless thetam > fei. LHE May 20, 2015
        }

    for (i = 0; i < soil->n_layer; i++)
    {
        if (soil->psim[i] > soil->psi_min)  // changed 10.0 to psi_min. LHE. Feb. 13, 2013.
            fpsisr[i] = 1.0 / (1 + std::pow((soil->psim[i] - soil->psi_min) / soil->psi_min, soil->alpha));   //psi_sr in m H2O! This is the old version. LHE.
        else
            fpsisr[i] = 1.0;

        ft[i] = (float)(1.0 - std::exp(t1 * std::pow(soil->temp_soil_p[i], t2))); // 1/x

        // ft[i] = min(ft[i], 1.0);  // LHE.
        //ft[i] = max(0.001, ft[i]); //  changed 0.1 to 0.001. LHE.

        fpsisr[i] = fpsisr[i] * ft[i];
    }


    for (i = 0; i < soil->n_layer; i++)
        dtt[i] = soil->f_root[i] * fpsisr[i]; /* eq. 14 in Ju 2006 */

    //dtt[0] = 0.0;
    float dtt_sum = 0.0;
    // for (i = 0; i < soil->n_layer; i++)
    for (i = 0; i < soil->n_layer -1; i++)
        dtt_sum = dtt_sum + dtt[i];/* eq. 14 in JU2006 */

    if (dtt_sum < 0.000001)
        soil->f_soilwater = 0.1; // when soil temperatures in all layers are <=0. LHe
    else
    {
        // for (i = 0; i < soil->n_layer; i++)
        for (i = 0; i < soil->n_layer -1; i++)
        {
            soil->dt[i] = dtt[i] / dtt_sum;

            //if (p->dt[0] < 0.0000001)
            //printf("%f\n", p->dt[0]);

            if (std::isnan(soil->dt[i]))
                printf("dt0: %f\n", ft[0]);
        }


        //fpsisr[0] = 0;
        float fpsisr_sum = 0;
        // for (i = 0; i < soil->n_layer; i++)
        for (i = 0; i < soil->n_layer -1; i++)
        {
            fpsisr_sum = fpsisr_sum + fpsisr[i] * soil->dt[i]; /* eq. 12, in Chen 2012 GBC; eq 15 in JU */
        }

        soil->f_soilwater = MAX(0.1, fpsisr_sum);
    }


    // in-process value check
    //printf("fpsisr[0]=%f\n",fpsisr[0]);
}

/// @brief Function to calcualte soil water uptake from a layer
/// @param soil       soil variables struct
/// @param Trans_o    transpiration from overstory canopies
/// @param Trans_u    transpiration from understory canopies
/// @param Evap_soil  evaporation from soil
/// @return void
void Soil_Water_Uptake(Soil_t* soil, float Trans_o, float Trans_u, float Evap_soil)
{
    int i;
    float Source;

    Source = Trans_o + Trans_u;

    // for the top layer
    soil->Ett[0] = Source * soil->dt[0] + Evap_soil;

    // for each layer:
    for (i = 1; i < soil->n_layer; i++)
        soil->Ett[i] = Source * soil->dt[i];
}

/// @brief Function to update soil moisture using the original Brooks-Corey model
/// @param p       soil variables struct
/// @param step   the total seconds in this step (period), defined in beps.h
/// @note kkk (outside of the function): step within an hour or half hour measurement
/// @return void
void UpdateSoilMoisture(Soil_t* p, float step)
{
    double Inf, Inf_max; // infiltration, and Maximum infiltration
    int i,flag=4;
    float this_step = 0; //LHE
    float total_t = 0; //LHE
    float max_Fb = 0; //LHE
    double soil_depth1_4 = 0,soil_depth1_3 = 0,soil_depth1_2 = 0;

    for(i=0; i< p->n_layer-1; i++)
        soil_depth1_4 += p->d_soil[i];

    for(i=0; i< p->n_layer-2; i++)
        soil_depth1_3 += p->d_soil[i];

    for(i=0; i< p->n_layer-3; i++)
        soil_depth1_2 += p->d_soil[i];

    /* 将当前土壤湿度存储到前一时刻土壤湿度变量中 */
    for(i=0; i<=p->n_layer; i++)
        p->thetam_prev[i] = p->thetam[i];
    /* 根据土壤的当前温度，计算土壤液态水比率 */
    for(i=0; i<=p->n_layer; i++)
    {
        if( p->temp_soil_c[i] > 0.0)
            p->f_ice[i] = 1.0;
        else if( p->temp_soil_c[i] < -1.0)
            p->f_ice[i] = 0.1;
        else p->f_ice[i] = 0.1 + 0.9 * ( p->temp_soil_c[i] + 1.0);
    }

    /*----------------上边界通量-------------------*/
    /* 计算最大下渗速率： (Original Brooks-Corey style) */
    Inf_max=p->f_ice[0] * p->Ksat[0] * ( 1 + (p->fei[0] - p->thetam_prev[0]) / p->d_soil[0] * p->psi_sat[0] * p->b[0] / p->fei[0]);
    /* 通过表层的积水量和降雨通量计算潜在入渗的水量 */
    Inf = MAX(p->f_ice[0] * (p->Zp / step + p->r_rain_g), 0);
    /* 实际入渗的水量(质量守恒约束) */
    Inf=MIN(Inf_max,Inf);
    Inf=MAX(0,Inf);

    /* 下渗后地表剩余的积水量 */
    p->Zp = (float)(p->Zp / step + p->r_rain_g - Inf) * step * 0.3;

    while(total_t < step)
    {
        if (soil_depth1_4 < p->dz  && p->fei[4] - p->thetam[4] >0.01)
            p->d_soil[4] = (float)(p->dz - soil_depth1_4);
        else
        {
            p->d_soil[4] = 0.5;
            p->thetam[4] = p->fei[4];
            flag = 3;
            if(p->d_soil[0] >= p->dz)
            {
                for(i=1; i< p->n_layer-1; i++)
                    p->thetam[i]=p->fei[i];
                p->thetam[0]=(float)(p->fei[0] * (p->d_soil[0] - p->dz) + p->thetam[0] * p->dz)/p->d_soil[0];
                flag = 0;
            }
            else if(p->d_soil[0] < p->dz && soil_depth1_2 >= p->dz)
            {
                for(i=2; i< p->n_layer-1; i++)
                    p->thetam[i]=p->fei[i];
                p->thetam[1]=(float)(p->fei[1] * (soil_depth1_2 - p->dz) + p->thetam[1] * (p->dz - p->d_soil[0]))/p->d_soil[1];
                flag = 1;
            }
            else if(soil_depth1_2 < p->dz && soil_depth1_3 >= p->dz)
            {
                for(i=2; i< p->n_layer-1; i++)
                    p->thetam[i]=p->fei[i];
                p->thetam[2]=(float)(p->fei[2] * (soil_depth1_3 - p->dz) + p->thetam[2] * (p->dz - soil_depth1_2))/p->d_soil[2];
                if(p->fei[2] - p->thetam[2] >= 0.01)
                    flag = 2;
                else
                {
                    flag = 1;
                    p->thetam[2] = p->fei[2];
                }
            }
            else if(soil_depth1_3 < p->dz && soil_depth1_4 >= p->dz)
            {
                p->thetam[3]=(float)(p->fei[3] * (soil_depth1_4 - p->dz) + p->thetam[3] * (p->dz - soil_depth1_3))/p->d_soil[3];
                if(p->fei[3] - p->thetam[3] >= 0.01)
                    flag = 3;
                else
                {
                    flag = 2;
                    p->thetam[3] = p->fei[3];
                }
            }
        }

        /*计算各层水力传导率 km (Brooks-Corey) */
        for(i=0; i < p->n_layer; i++)
            p->km[i] = p->f_ice[i] * p->Ksat[i] * std::pow((p->thetam[i] / p->fei[i]), (2 * p->b[i] + 3));

        for (i = flag + 1; i < p->n_layer; i++)
        {
            p->thetam[i] = p->fei[i];
            p->thetab[i] = p->fei[i];
        }

        for (i = 0; i <= flag; i++)
        {
            if (i < flag)
            {
                p->thetab[i] = (float)((p->thetam[i + 1] / p->d_soil[i + 1] + p->thetam[i] / p->d_soil[i]) / (1.0 / p->d_soil[i] + 1.0 / p->d_soil[i + 1]));
            }
            else
            {
                p->thetab[i] = p->fei[i];
            }
        }

        /* 计算层间的导水率 (Brooks-Corey) */
        for(i = 0; i < p->n_layer; i++)
        {
            if(i < p->n_layer - 1 )
            {
                p->Kb[i] = p->f_ice[i] * (p->Ksat[i] * p->d_soil[i] + p->Ksat[i+1] * p->d_soil[i + 1]) / (p->d_soil[i] + p->d_soil[i + 1]) * std::pow(p->thetab[i] / p->fei[i], (2 * p->b[i] + 3));
            }
            else
                p->Kb[i] = 0.5 * p->f_ice[i] * p->Ksat[i] * std::pow(p->thetab[i] / p->fei[i], (2 * p->b[i] + 3));
        }

        /* 计算土壤层中心水势（Clapp-Hornberger 方程） */
        for(i = 0;i <= p->n_layer - 1;i++)
        {
            p->psim[i] = p->psi_sat[i] * std::pow(p->thetam[i] / p->fei[i], - p->b[i]);
            p->psim[i] = MAX(p->psi_sat[i], p->psim[i] );
        }

        /* 计算土壤层间界面处水势（Clapp-Hornberger 方程） */
        for(i=0; i < p->n_layer; i++)
        {
            p->psib[i] = p->psi_sat[i] * std::pow(p->thetab[i] / p->fei[i], - p->b[i]);
            p->psib[i] = MIN(p->psi_sat[i], p->psib[i]);
        }

        /* Seller's 加权平均和形状修正的层间界面处的等效导水率 */
        for(i = 0; i < flag; i++)
        {
            p->KK[i] = (p->km[i] * p->psim[i] + p->km[i + 1] * p->psim[i + 1])  \
                / (p->psim[i] + p->psim[i + 1]) \
                * (p->b[i] + p->b[i + 1]) / (p->b[i] + p->b[i + 1] + 6);
        }

        p->KK[flag] = (p->km[flag] * p->psim[flag] + p->Kb[flag] * p->psib[flag])  \
            / (p->psim[flag] + p->psib[flag]) * p->b[flag] / (p->b[flag] + 3);

        for(i=0;i <= p->n_layer - 1; i++)
        {
            if(i < flag)
            {
                p->r_waterflow[i] = p->KK[i] * (2*(p->psim[i+1] - p->psim[i]) / (p->d_soil[i] + p->d_soil[i+1])+1);
            }
            else
                p->r_waterflow[i] = 0;
        }

        for(i=0;i<p->n_layer-1;i++)
        {
            p->r_waterflow[i] = MIN((p->fei[i+1] - p->thetam[i+1]) * p->d_soil[i+1] / step + p->Ett[i+1], p->r_waterflow[i]);
            if(std::fabs(p->r_waterflow[i]) > max_Fb) max_Fb = std::fabs(p->r_waterflow[i]);
        }

        if(max_Fb > 1.0e-5)
            this_step = 1.0;
        else if(max_Fb > 1.0e-6)
            this_step = 30.0;
        else this_step = 360.0;
        total_t = total_t + this_step;
        if(total_t > step) this_step = this_step - (total_t - step);

        for(i=0;i < p->n_layer;i++)
        {
            if(i==0)
                p->thetam[i] = p->thetam[i] + (Inf * this_step - p->r_waterflow[i] * this_step - p->Ett[i] * this_step) / p->d_soil[i];
            else
                p->thetam[i] = p->thetam[i] + (p->r_waterflow[i-1] * this_step - p->r_waterflow[i] * this_step - p->Ett[i] * this_step) / p->d_soil[i];

            p->thetam[i] = MAX(p->theta_vwp[i], p->thetam[i]);
            p->thetam[i] = MIN(p->fei[i],p->thetam[i]);
        }

        double q_drain = p->r_waterflow[flag-1]/p->thetam[flag];
        double dz_change = -q_drain * this_step;
        p->dz += dz_change;

        if (p->dz < 0.0)
        {
            p->Zp += -p->dz * p->fei[0];
            p->dz = 0.0;
        }
    }
}


/// @brief Function to update soil moisture using the new Van Genuchten-Mualem model
/// @param p       soil variables struct
/// @param step   the total seconds in this step (period), defined in beps.h
/// @note kkk (outside of the function): step within an hour or half hour measurement
/// @return void
void UpdateSoilMoisture_VGM(Soil_t* p, float step)
{
    double Inf, Inf_max; // infiltration, and Maximum infiltration
    int i,flag=4;
    float this_step = 0; //LHE
    float total_t = 0; //LHE
    float max_Fb = 0; //LHE
    double soil_depth1_4 = 0,soil_depth1_3 = 0,soil_depth1_2 = 0;

    for(i=0; i< p->n_layer-1; i++)
        soil_depth1_4 += p->d_soil[i];

    for(i=0; i< p->n_layer-2; i++)
        soil_depth1_3 += p->d_soil[i];

    for(i=0; i< p->n_layer-3; i++)
        soil_depth1_2 += p->d_soil[i];

    /* 将当前土壤湿度存储到前一时刻土壤湿度变量中 */
    for(i=0; i<=p->n_layer; i++)
        p->thetam_prev[i] = p->thetam[i];
    /* 根据土壤的当前温度，计算土壤液态水比率 */
    for(i=0; i<=p->n_layer; i++)
    {
        if( p->temp_soil_c[i] > 0.0)
            p->f_ice[i] = 1.0;
        else if( p->temp_soil_c[i] < -1.0)
            p->f_ice[i] = 0.1;
        else p->f_ice[i] = 0.1 + 0.9 * ( p->temp_soil_c[i] + 1.0);
    }

    /*----------------上边界通量-------------------*/
    /* 计算最大下渗速率： Green-Ampt 模型 */
    Inf_max = surface_infiltration(p);
    /* 通过表层的积水量和降雨通量计算潜在入渗的水量 */
    Inf = MAX(p->f_ice[0] * (p->Zp / step + p->r_rain_g), 0);
    /* 实际入渗的水量(质量守恒约束) */
    Inf=MIN(Inf_max,Inf);
    Inf=MAX(0,Inf);

    /* 下渗后地表剩余的积水量 */
    p->Zp = (float)(p->Zp / step + p->r_rain_g - Inf) * step * 0.3;

    while(total_t < step)
    {
        if (soil_depth1_4 < p->dz  && p->fei[4] - p->thetam[4] >0.01)
            p->d_soil[4] = (float)(p->dz - soil_depth1_4);
        else
        {
            p->d_soil[4] = 0.5;
            p->thetam[4] = p->fei[4];
            flag = 3;
            if(p->d_soil[0] >= p->dz)
            {
                for(i=1; i< p->n_layer-1; i++)
                    p->thetam[i]=p->fei[i];
                p->thetam[0]=(float)(p->fei[0] * (p->d_soil[0] - p->dz) + p->thetam[0] * p->dz)/p->d_soil[0];
                flag = 0;
            }
            else if(p->d_soil[0] < p->dz && soil_depth1_2 >= p->dz)
            {
                for(i=2; i< p->n_layer-1; i++)
                    p->thetam[i]=p->fei[i];
                p->thetam[1]=(float)(p->fei[1] * (soil_depth1_2 - p->dz) + p->thetam[1] * (p->dz - p->d_soil[0]))/p->d_soil[1];
                flag = 1;
            }
            else if(soil_depth1_2 < p->dz && soil_depth1_3 >= p->dz)
            {
                for(i=2; i< p->n_layer-1; i++)
                    p->thetam[i]=p->fei[i];
                p->thetam[2]=(float)(p->fei[2] * (soil_depth1_3 - p->dz) + p->thetam[2] * (p->dz - soil_depth1_2))/p->d_soil[2];
                if(p->fei[2] - p->thetam[2] >= 0.01)
                    flag = 2;
                else
                {
                    flag = 1;
                    p->thetam[2] = p->fei[2];
                }
            }
            else if(soil_depth1_3 < p->dz && soil_depth1_4 >= p->dz)
            {
                p->thetam[3]=(float)(p->fei[3] * (soil_depth1_4 - p->dz) + p->thetam[3] * (p->dz - soil_depth1_3))/p->d_soil[3];
                if(p->fei[3] - p->thetam[3] >= 0.01)
                    flag = 3;
                else
                {
                    flag = 2;
                    p->thetam[3] = p->fei[3];
                }
            }
        }

        /*计算各层水力传导率 km (VGM) */
        for(i=0; i < p->n_layer; i++)
            k_mid( p, i);

        for (i = flag + 1; i < p->n_layer; i++)
        {
            p->thetam[i] = p->fei[i];
            p->thetab[i] = p->fei[i];
        }

        for (i = 0; i <= flag; i++)
        {
            if (i < flag)
            {
                p->thetab[i] = (float)((p->thetam[i + 1] / p->d_soil[i + 1] + p->thetam[i] / p->d_soil[i]) / (1.0 / p->d_soil[i] + 1.0 / p->d_soil[i + 1]));
            }
            else
            {
                p->thetab[i] = p->fei[i];
            }
        }

        /* 计算层间的导水率 (VGM) */
        for(i = 0; i < p->n_layer; i++)
        {
            if(i < p->n_layer - 1 )
            {
                k_bottom(p,i);
            }
            else
                p->Kb[i] = 0.5 * p->f_ice[i] * p->Ksat[i] * std::pow(p->thetab[i] / p->fei[i], (2 * p->b[i] + 3));
        }

        /* 计算土壤层中心水势 (VGM) */
        for(i = 0;i <= p->n_layer - 1;i++)
        {
            psi_mid(p,i);
            p->psim[i] = MAX(p->psi_sat[i], p->psim[i] );
        }

        /* 计算土壤层间界面处水势 (VGM) */
        for(i=0; i < p->n_layer; i++)
        {
            psi_bottom(p,i);
            p->psib[i] = MIN(p->psi_sat[i], p->psib[i]);
        }

        /* Seller's 加权平均和形状修正的层间界面处的等效导水率 */
        for(i = 0; i < flag; i++)
        {
            p->KK[i] = (p->km[i] * p->psim[i] + p->km[i + 1] * p->psim[i + 1])  \
                / (p->psim[i] + p->psim[i + 1]) \
                * (p->b[i] + p->b[i + 1]) / (p->b[i] + p->b[i + 1] + 6);
        }

        p->KK[flag] = (p->km[flag] * p->psim[flag] + p->Kb[flag] * p->psib[flag])  \
            / (p->psim[flag] + p->psib[flag]) * p->b[flag] / (p->b[flag] + 3);

        for(i=0;i <= p->n_layer - 1; i++)
        {
            if(i < flag)
            {
                p->r_waterflow[i] = p->KK[i] * (2*(p->psim[i+1] - p->psim[i]) / (p->d_soil[i] + p->d_soil[i+1])+1);
            }
            else
                p->r_waterflow[i] = 0;
        }

        for(i=0;i<p->n_layer-1;i++)
        {
            p->r_waterflow[i] = MIN((p->fei[i+1] - p->thetam[i+1]) * p->d_soil[i+1] / step + p->Ett[i+1], p->r_waterflow[i]);
            if(std::fabs(p->r_waterflow[i]) > max_Fb) max_Fb = std::fabs(p->r_waterflow[i]);
        }

        if(max_Fb > 1.0e-5)
            this_step = 1.0;
        else if(max_Fb > 1.0e-6)
            this_step = 30.0;
        else this_step = 360.0;
        total_t = total_t + this_step;
        if(total_t > step) this_step = this_step - (total_t - step);

        for(i=0;i < p->n_layer;i++)
        {
            if(i==0)
                p->thetam[i] = p->thetam[i] + (Inf * this_step - p->r_waterflow[i] * this_step - p->Ett[i] * this_step) / p->d_soil[i];
            else
                p->thetam[i] = p->thetam[i] + (p->r_waterflow[i-1] * this_step - p->r_waterflow[i] * this_step - p->Ett[i] * this_step) / p->d_soil[i];

            p->thetam[i] = MAX(p->theta_vwp[i], p->thetam[i]);
            p->thetam[i] = MIN(p->fei[i],p->thetam[i]);
        }

        double q_drain = p->r_waterflow[flag-1]/p->thetam[flag];
        double dz_change = -q_drain * this_step;
        p->dz += dz_change;

        if (p->dz < 0.0)
        {
            p->Zp += -p->dz * p->fei[0];
            p->dz = 0.0;
        }
    }
}


/// @brief Helper function to calculate effective saturation (Se)
/// @param theta Current volumetric water content
/// @param theta_r Residual water content
/// @param theta_s Saturated water content
/// @return Effective saturation (Se)
float calculate_effective_saturation(float theta, float theta_r, float theta_s)
{
    float Se = (theta - theta_r) / (theta_s - theta_r);
    return std::min(std::max(Se, 0.01f), 1.0f);
}

float surface_infiltration(Soil_t* p)
{
    float Se = calculate_effective_saturation(p->thetam_prev[0], p->theta_vwp[0], p->fei[0]);
    float m = p->pm[0];
    float n = p->pn[0];
    return p->f_ice[0] * p->Ksat[0] * (1 + (p->fei[0] - p->thetam_prev[0]) / p->d_soil[0] * p->psi_sat[0] * std::pow(std::pow(1.0f / Se, 1.0f / m) - 1.0f, 1.0f / n));
}

void k_mid(Soil_t* p,int i)
{
    float Se = calculate_effective_saturation(p->thetam[i], p->theta_vwp[i], p->fei[i]);
    float m = p->pm[i];
    p->km[i] = p->f_ice[i] * p->Ksat[i] * std::sqrt(Se) * std::pow(1.0f - std::pow(1.0f - std::pow(Se, 1.0f / m), m), 2.0f);
}

void k_bottom(Soil_t* p,int i)
{
    float Se = calculate_effective_saturation(p->thetab[i], p->theta_vwp[i], p->fei[i]);
    float m = p->pm[i];
    float K_avg = (p->Ksat[i] * p->d_soil[i] + p->Ksat[i + 1] * p->d_soil[i + 1]) / (p->d_soil[i] + p->d_soil[i + 1]);
    p->Kb[i] = p->f_ice[i] * K_avg * std::sqrt(Se) * std::pow(1.0f - std::pow(1.0f - std::pow(Se, 1.0f / m), m), 2.0f);
}

void psi_mid(Soil_t* p,int i)
{
    float Se = calculate_effective_saturation(p->thetam[i], p->theta_vwp[i], p->fei[i]);
    float m = p->pm[i];
    float n = p->pn[i];
    p->psim[i] = p->psi_sat[i] * std::pow(std::pow(1.0f / Se, 1.0f / m) - 1.0f, 1.0f / n);
}

void psi_bottom(Soil_t* p,int i)
{
    float Se = calculate_effective_saturation(p->thetab[i], p->theta_vwp[i], p->fei[i]);
    float m = p->pm[i];
    float n = p->pn[i];
    p->psib[i] = p->psi_sat[i] * std::pow(std::pow(1.0f / Se, 1.0f / m) - 1.0f, 1.0f / n);
}

// 多层土壤侧向流量计算函数
// 辅助函数：计算单个方向的流量
static double calculate_single_layer_flow(
    pubv* myseed,
    int current_j, int current_iLine, int dir, int layer,
    Soil_t* current_soil,
    float* Array_Ele, unsigned char* watershed, double dx_val,
    Soil_index_t* soilindex, short textureindex)
{
    Soil_t* center_soil = &current_soil[4];
    Soil_t* neighbor_soil = &current_soil[dir];
    int iX = myseed->nlines;
    int iY = myseed->npixels;
    int ni = current_iLine + (dir < 3 ? -1 : (dir > 4 ? 1 : 0));
    int nj = current_j + ((dir == 0 || dir == 3 || dir == 5) ? -1 : (dir == 2 || dir == 4 || dir == 7) ? 1 : 0);
    if (dir == 4 || ni < 0 || ni >= iX || nj < 0 || nj >= iY || watershed[nj] == 0 || Array_Ele[ni * iY + nj] >= 9999.0f) {
        return 0.0;
    }
    float Ks = soilindex[textureindex].soil_K0H[layer];
    float current_theta = center_soil->thetam[layer];
    float current_theta_s = center_soil->fei[layer];
    float current_layer_thickness = center_soil->d_soil[layer];
    float neighbor_theta = neighbor_soil->thetam[layer];
    float neighbor_theta_s = neighbor_soil->fei[layer];
    float kr = pow(current_theta / current_theta_s, 2 * center_soil->b[layer] + 3);
    double current_layer_top = Array_Ele[current_iLine * myseed->npixels + current_j];
    double neighbor_layer_top = Array_Ele[ni * myseed->npixels + nj];
    for (int l = 0; l < layer; l++) {
        current_layer_top -= center_soil->d_soil[l];
        neighbor_layer_top -= neighbor_soil->d_soil[l];
    }
    double dz = current_layer_top - neighbor_layer_top;
    double h1 = center_soil->psi_sat[layer] * pow(current_theta / current_theta_s, -center_soil->b[layer]);
    double h2 = neighbor_soil->psi_sat[layer] * pow(neighbor_theta / neighbor_theta_s, -neighbor_soil->b[layer]);
    double dh = h1 - h2;
    double gradient = (dh + dz) / dx_val;
    double flow_rate_per_area = -Ks * kr * gradient;
    double contact_area = current_layer_thickness * dx_val;
    double flow_volume = flow_rate_per_area * contact_area;
    if (flow_volume > 0) {
        double available_water = (current_theta - center_soil->theta_vwp[layer]) * current_layer_thickness * dx_val;
        flow_volume = MIN(flow_volume, available_water);
    } else {
        double neighbor_receiving_capacity = (neighbor_soil->fei[layer] - neighbor_theta) * neighbor_soil->d_soil[layer] * dx_val;
        flow_volume = MAX(flow_volume, -neighbor_receiving_capacity);
    }
    return flow_volume;
}

// 自适应时间步长的多层土壤侧向流动与水分更新
void UpdateSoilLateralFlow(pubv* myseed, int iLine, int j, Soil_t* soil, 
                          Soil_t* Soil_Array_3r, float* Array_Ele, unsigned char* watershed, 
                          unsigned char* soil_texture, Soil_index_t* soilindex, float step)
{
    int iX = myseed->nlines;
    int iY = myseed->npixels;
    double dx_cardinal = (double)(myseed->iXsize);
    double dx_diagonal = dx_cardinal * 1.4142135623730951;
    float total_t = 0;
    float max_flow = 0;
    float this_step = step;
    short textureindex;
    if(soil_texture[j] > 0 && soil_texture[j] <= 120) {
        textureindex = soil_texture[j]/10 - 1;
    } else {
        textureindex = 1;
    }
    Soil_t current_soil[9];
    double net_lateral_flow[MAX_LAYERS] = {0};
    while(total_t < step) {
        ReadInSoil(Soil_Array_3r, current_soil, iLine, j, myseed);
        max_flow = 0;
        // 1. 先累计净流量
        for(int layer = 0; layer < MAX_LAYERS; layer++) {
            net_lateral_flow[layer] = 0.0;
            bool is_all_neighbors_higher = true;
            bool has_any_valid_watershed_neighbor = false;
            for(int dir_check = 0; dir_check < 8; dir_check++) {
                int ni_check = iLine + (dir_check < 3 ? -1 : (dir_check > 4 ? 1 : 0));
                int nj_check = j + ((dir_check == 0 || dir_check == 3 || dir_check == 5) ? -1 : 
                                    (dir_check == 2 || dir_check == 4 || dir_check == 7) ? 1 : 0);
                if (ni_check >= 0 && ni_check < iX && nj_check >= 0 && nj_check < iY &&
                    watershed[nj_check] != 0 && Array_Ele[ni_check * iY + nj_check] < 9999.0f) {
                    has_any_valid_watershed_neighbor = true;
                    if (Array_Ele[ni_check * iY + nj_check] <= Array_Ele[iLine * iY + j]) {
                        is_all_neighbors_higher = false;
                        break;
                    }
                }
            }
            for(int dir = 0; dir < 8; dir++) {
                double current_dx = (dir % 2 == 0) ? dx_diagonal : dx_cardinal;
                double flow = calculate_single_layer_flow(
                    myseed, j, iLine, dir, layer,
                    current_soil, Array_Ele, watershed, current_dx,
                    soilindex, textureindex);
                net_lateral_flow[layer] += flow;
                if(fabs(flow) > max_flow) max_flow = fabs(flow);
            }
            // 出水口处理
            if(is_all_neighbors_higher && has_any_valid_watershed_neighbor) {
                if (net_lateral_flow[layer] > 0) net_lateral_flow[layer] = 0;
            }
        }
        // 2. 统一更新thetam
        for(int layer = 0; layer < MAX_LAYERS; layer++) {
            double dtheta = net_lateral_flow[layer] / (current_soil[4].d_soil[layer] * dx_cardinal);
            current_soil[4].thetam[layer] += dtheta * (this_step/step);
            current_soil[4].thetam[layer] = MAX(current_soil[4].theta_vwp[layer], MIN(current_soil[4].thetam[layer], current_soil[4].fei[layer]));
        }
        // 更新回soil[j]
        for(int layer = 0; layer < MAX_LAYERS; layer++) {
            soil[j].thetam[layer] = current_soil[4].thetam[layer];
        }
        total_t += this_step;
        // 自适应步长
        if(max_flow > 1e-5)
            this_step = step/120.0f;
        else if(max_flow > 1e-6)
            this_step = step/12.0f;
        else
            this_step = step;
        if(total_t + this_step > step)
            this_step = step - total_t;
    }
}